{
  "id": "agent-code-poker",
  "name": "Agent Code Poker",
  "description": "Take a seat in a block-built poker room. No-Limit Hold\u2019em, five opponents, all yours.",
  "version": "0.1.1",
  "apiVersion": 2,
  "entry": "dist/runtime.js",
  "activationEvents": [
    "onView:agent-code-poker.open"
  ],
  "contributes": {
    "commands": [
      {
        "id": "agent-code-poker.open",

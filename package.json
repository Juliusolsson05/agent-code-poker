{
  "name": "agent-code-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A block-built poker room for Agent Code",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.ts --host 127.0.0.1",
    "lan": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build && npm run build:lan && npm run build:service",
    "build:lan": "vite build --config vite.lan.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:contract": "node --test testing/contract.test.mjs",
    "test:preview": "node --test testing/preview.test.mjs",
    "verify": "npm test && npm run build && npm run test:contract && npm run test:preview",
    "build:service": "esbuild server/service.ts --bundle --platform=node --format=cjs --outfile=dist-service/lan-host.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "5.2.0",
    "agent-code-extension-api": "github:Juliusolsson05/agent-code-extension-api#v0.9.0",
    "esbuild": "^0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
